generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @default("")
  passwordHash String
  role         String   @default("client") // client | admin
  createdAt    DateTime @default(now())

  bookings      Booking[]
  favorites     Artist[]       @relation("Favorites")
  cards         Card[]
  references    Reference[]
  notifications Notification[]
  reviews       Review[]
}

model Artist {
  id              String   @id @default(cuid())
  name            String
  style           String
  years           Int      @default(0)
  bio             String   @default("")
  available       Boolean  @default(true)
  unavailableNote String   @default("")
  avatar          Bytes? // foto do artista (omitida por padrão nas consultas)
  avatarMime      String   @default("")
  avatarVersion   Int      @default(0) // muda a cada troca: invalida o cache da imagem
  archived        Boolean  @default(false) // excluído da equipe, mas mantido pelo histórico de agendamentos
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  services  Service[]     @relation("ArtistServices")
  photos    ArtistPhoto[]
  bookings  Booking[]
  reviews   Review[]
  favoredBy User[]        @relation("Favorites")
}

model ArtistPhoto {
  id        String   @id @default(cuid())
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  createdAt DateTime @default(now())

  likes    PhotoLike[]
  comments PhotoComment[]

  @@index([artistId])
}

// Curtida da galeria: uma por aparelho (voter = id aleatório salvo no navegador).
model PhotoLike {
  photoId   String
  photo     ArtistPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  voter     String
  createdAt DateTime    @default(now())

  @@id([photoId, voter])
}

model PhotoComment {
  id        String      @id @default(cuid())
  photoId   String
  photo     ArtistPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  phoneKey  String
  name      String
  text      String
  createdAt DateTime    @default(now())

  @@index([photoId, createdAt])
}

// Perfil do cliente (sem conta): identificado pelo celular. O id opaco vai nas URLs, nunca o número.
model ClientProfile {
  id            String   @id @default(cuid())
  phoneKey      String   @unique
  name          String   @default("")
  avatar        Bytes?
  avatarMime    String   @default("")
  avatarVersion Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  kind      String // elogio | sugestao | reclamacao | outro
  message   String
  name      String   @default("")
  phoneKey  String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WhatsAppLog {
  id        String   @id @default(cuid())
  to        String
  event     String
  text      String
  status    String // sent | failed
  error     String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  priceCents  Int
  durationMin Int
  icon        String   @default("pen")
  photo        Bytes? // foto do serviço (omitida por padrão nas consultas)
  photoMime    String   @default("")
  photoVersion Int      @default(0)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  artists  Artist[]  @relation("ArtistServices")
  bookings Booking[]
}

model Booking {
  id             String    @id @default(cuid())
  clientId       String?
  client         User?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName     String
  clientPhone    String    @default("")
  phoneKey       String    @default("") // só dígitos, sem o 55: chave para o cliente ver os agendamentos
  artistId       String
  artist         Artist    @relation(fields: [artistId], references: [id], onDelete: Restrict)
  serviceId      String
  service        Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  date           String // YYYY-MM-DD
  time           String // HH:MM
  durationMin    Int
  priceCents     Int
  depositCents   Int
  status         String // requested | pending_deposit | confirmed | completed | cancelled | rejected
  paymentMethod  String    @default("studio") // card | pix | tap | studio
  depositPaid    Boolean   @default(false)
  notes          String    @default("")
  cancelReason   String    @default("")
  completedAt    DateTime?
  reminderSentAt DateTime? // lembrete de véspera pelo WhatsApp
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payments   Payment[]
  review     Review?
  references Reference[]

  @@index([date])
  @@index([artistId, date])
  @@index([clientId])
  @@index([phoneKey])
  @@index([status])
}

model Payment {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind        String // deposit | final
  method      String // card | pix | tap | cash | studio
  amountCents Int
  day         String // YYYY-MM-DD no fuso do estúdio
  createdAt   DateTime @default(now())

  @@index([day])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@index([artistId])
}

model Card {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     String
  last4     String
  expiry    String // MM/AA
  holder    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Reference {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  note      String   @default("")
  mime      String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @default("")
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Setting {
  key   String @id
  value String
}
